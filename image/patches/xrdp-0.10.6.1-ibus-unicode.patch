+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#if defined(HAVE_CONFIG_H)
+#include <config_ac.h>
+#endif
+
+#include <glib.h>
+#include <glib-object.h>
+#include <glib/gstdio.h>
+#include <ibus.h>
+#include <unistd.h>
+#include <X11/Xlib.h>
+#include <X11/keysym.h>
+#include <X11/extensions/XTest.h>
+#include "input.h"
+#include "thread_calls.h"
+
+static IBusBus *bus;
+static IBusEngine *g_engine;
+static gchar *focused_context;
+static GMutex engine_mutex;
+static gint factory_ready;
+/* This is the engine name enabled before unicode engine enabled */
+static gchar *last_input_name;
+static int id = 0;
+
+static int
+xrdp_input_enable(void)
+{
+    IBusEngineDesc *desc;
+    const gchar *name;
+
+    if (last_input_name)
+    {
+        /* already enabled */
+        return 0;
+    }
+
+    if (!bus)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_ibus_init: input method switched failed, ibus not connected");
+        return 1;
+    }
+
+    desc = ibus_bus_get_global_engine(bus);
+    if (desc == NULL)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_input_enable: no current IBus engine");
+        return 1;
+    }
+    name = ibus_engine_desc_get_name(desc);
+    if (name == NULL)
+    {
+        g_object_unref(desc);
+        return 1;
+    }
+    if (!g_ascii_strcasecmp(name, "XrdpIme"))
+    {
+        g_object_unref(desc);
+        return 0;
+    }
+
+    /* remember user's input method, will switch back when disconnect */
+    last_input_name = g_strdup(name);
+    g_object_unref(desc);
+
+    if (!ibus_bus_set_global_engine(bus, "XrdpIme"))
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_input_enable: input method enable failed");
+        g_clear_pointer(&last_input_name, g_free);
+        return 1;
+    }
+
+    LOG(LOG_LEVEL_INFO, "xrdp_ibus_init: input method switched sucessfully, old input name: %s", last_input_name);
+
+    return 0;
+}
+
+/* Chromium GTK3 binds its XIM client window only after a native key event.
+ * A first phone Unicode commit otherwise targets IBus's fake desktop context.
+ * Prime only an unbound context, without producing text or changing a held key. */
+static int
+xrdp_input_prime_context(void)
+{
+    Display *display = XOpenDisplay(NULL);
+    KeyCode shift;
+    char keys[32];
+    int event_base, error_base, major, minor;
+    int rv = 1;
+
+    if (display == NULL)
+    {
+        return 1;
+    }
+    shift = XKeysymToKeycode(display, XK_Shift_L);
+    if (shift != 0 &&
+            XTestQueryExtension(display, &event_base, &error_base, &major, &minor))
+    {
+        XQueryKeymap(display, keys);
+        if (keys[shift / 8] & (1 << (shift % 8)))
+        {
+            /* A real modifier is already down; never release the user's key. */
+            rv = 0;
+        }
+        else if (XTestFakeKeyEvent(display, shift, True, CurrentTime))
+        {
+            rv = XTestFakeKeyEvent(display, shift, False, CurrentTime) ? 0 : 1;
+        }
+        XSync(display, False);
+    }
+    XCloseDisplay(display);
+    return rv;
+}
+
+int
+xrdp_input_send_unicode(char32_t unicode)
+{
+    IBusEngine *engine = NULL;
+    unsigned int attempt;
+
+    LOG(LOG_LEVEL_DEBUG, "xrdp_input_send_unicode: received Unicode input event");
+
+    if (xrdp_input_enable())
+    {
+        return 1;
+    }
+
+    g_mutex_lock(&engine_mutex);
+    if (g_engine != NULL)
+    {
+        engine = g_object_ref(g_engine);
+    }
+    g_mutex_unlock(&engine_mutex);
+    if (engine == NULL && xrdp_input_prime_context())
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_input_send_unicode: could not initialize XIM context");
+        return 1;
+    }
+
+    /* Wait for a real focused application, not IBus's fake desktop context.
+     * The focus callback is delivered on the GLib thread after the native key. */
+    for (attempt = 0; engine == NULL && attempt < 200; ++attempt)
+    {
+        g_mutex_lock(&engine_mutex);
+        if (g_engine != NULL)
+        {
+            engine = g_object_ref(g_engine);
+        }
+        g_mutex_unlock(&engine_mutex);
+        if (engine != NULL)
+        {
+            break;
+        }
+        g_usleep(10000);
+    }
+    if (engine == NULL)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_input_send_unicode: IBus engine not ready");
+        return 1;
+    }
+
+    ibus_engine_commit_text(engine, ibus_text_new_from_unichar(unicode));
+    g_object_unref(engine);
+
+    return 0;
+}
+
+static void
+xrdp_input_ibus_engine_enable(IBusEngine *engine)
+{
+    LOG(LOG_LEVEL_INFO, "xrdp_ibus_engine_enable: IM enabled");
+}
+
+static void
+xrdp_input_ibus_engine_disable(IBusEngine *engine)
+{
+    IBusEngine *previous = NULL;
+
+    LOG(LOG_LEVEL_INFO, "xrdp_ibus_engine_disable: IM disabled");
+    g_mutex_lock(&engine_mutex);
+    if (g_engine == engine)
+    {
+        previous = g_engine;
+        g_engine = NULL;
+        g_clear_pointer(&focused_context, g_free);
+    }
+    g_mutex_unlock(&engine_mutex);
+    g_clear_object(&previous);
+}
+
+static void
+xrdp_input_ibus_focus_in(IBusEngine *engine,
+                         const gchar *object_path,
+                         const gchar *client)
+{
+    IBusEngine *previous;
+
+    g_mutex_lock(&engine_mutex);
+    previous = g_engine;
+    g_engine = NULL;
+    g_clear_pointer(&focused_context, g_free);
+    if (client != NULL && g_strcmp0(client, "fake") != 0 && object_path != NULL)
+    {
+        g_engine = g_object_ref(engine);
+        focused_context = g_strdup(object_path);
+    }
+    g_mutex_unlock(&engine_mutex);
+    g_clear_object(&previous);
+}
+
+static void
+xrdp_input_ibus_focus_out(IBusEngine *engine, const gchar *object_path)
+{
+    IBusEngine *previous = NULL;
+
+    g_mutex_lock(&engine_mutex);
+    if (g_engine == engine && g_strcmp0(focused_context, object_path) == 0)
+    {
+        previous = g_engine;
+        g_engine = NULL;
+        g_clear_pointer(&focused_context, g_free);
+    }
+    g_mutex_unlock(&engine_mutex);
+    g_clear_object(&previous);
+}
+
+static void
+xrdp_input_ibus_disconnect(IBusBus *disconnected_bus, gpointer user_data)
+{
+    /* A dead bus cannot be reused safely by the live GLib thread. Fail the
+     * channel process rather than leave dangling shared pointers. */
+    LOG(LOG_LEVEL_ERROR, "xrdp_input_ibus_disconnect: IBus connection lost");
+    _exit(1);
+}
+
+static gboolean
+engine_process_key_event_cb(IBusEngine *engine,
+                            guint keyval,
+                            guint keycode,
+                            guint state)
+{
+    /* Pass the keyboard event to system */
+    return FALSE;
+}
+
+static IBusEngine *
+xrdp_input_ibus_create_engine(IBusFactory *factory,
+                              gchar *engine_name,
+                              gpointer user_data)
+{
+    IBusEngine *engine;
+    gchar *path = g_strdup_printf("/org/freedesktop/IBus/Engine/%i", ++id);
+    engine = g_object_new(IBUS_TYPE_ENGINE,
+                           "engine-name", engine_name,
+                           "object-path", path,
+                           "connection", ibus_bus_get_connection(bus),
+                           "has-focus-id", TRUE, NULL);
+    g_free(path);
+    if (engine == NULL)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_input_ibus_create_engine: engine creation failed");
+        return NULL;
+    }
+
+    LOG(LOG_LEVEL_DEBUG, "xrdp_input_ibus_create_engine: Creating IM Engine with name:%s and id:%d\n", engine_name, id);
+
+    g_signal_connect(engine, "process-key-event", G_CALLBACK(engine_process_key_event_cb), NULL);
+    g_signal_connect(engine, "enable", G_CALLBACK(xrdp_input_ibus_engine_enable), NULL);
+    g_signal_connect(engine, "disable", G_CALLBACK(xrdp_input_ibus_engine_disable), NULL);
+    g_signal_connect(engine, "focus-in-id", G_CALLBACK(xrdp_input_ibus_focus_in), NULL);
+    g_signal_connect(engine, "focus-out-id", G_CALLBACK(xrdp_input_ibus_focus_out), NULL);
+
+    return engine;
+}
+
+/*****************************************************************************/
+static THREAD_RV THREAD_CC
+xrdp_input_main_loop(void *in_val)
+{
+    IBusFactory *factory;
+    IBusComponent *component;
+    IBusEngineDesc *desc;
+    THREAD_RV rv = 0;
+
+    LOG(LOG_LEVEL_DEBUG, "xrdp_input_main_loop: Entering ibus loop");
+
+    g_signal_connect(bus, "disconnected", G_CALLBACK(xrdp_input_ibus_disconnect), NULL);
+
+    factory = ibus_factory_new(ibus_bus_get_connection(bus));
+    g_object_ref_sink(factory);
+    g_signal_connect(factory, "create-engine", G_CALLBACK(xrdp_input_ibus_create_engine), NULL);
+
+    ibus_factory_add_engine(factory, "XrdpIme", IBUS_TYPE_ENGINE);
+
+    component = ibus_component_new("org.freedesktop.IBus.XrdpIme", /* name */
+                                   "Xrdp input method",            /* description */
+                                   "1.1",                          /* version */
+                                   "MIT",                          /* license */
+                                   "seflerZ",                      /* author */
+                                   "default",                      /* homepage */
+                                   "default",                      /* cmd */
+                                   "xrdpime");                     /* text domain */
+
+    desc = ibus_engine_desc_new("XrdpIme",
+                                "unicode input method for xrdp",
+                                "unicode input method for xrdp",
+                                "unicode",
+                                "MIT",
+                                "seflerZ",
+                                "default",  /* icon */
+                                "default"); /* layout */
+
+    ibus_component_add_engine(component, desc);
+    if (!ibus_bus_register_component(bus, component))
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_input_main_loop: engine registration failed");
+        _exit(1);
+    }
+    g_atomic_int_set(&factory_ready, 1);
+
+    ibus_main();
+
+    g_object_unref(desc);
+    g_object_unref(component);
+    g_object_unref(factory);
+
+    LOG(LOG_LEVEL_ERROR, "xrdp_input_main_loop: input loop exited unexpectedly");
+    _exit(1);
+    return rv;
+}
+
+int
+xrdp_input_unicode_destroy(void)
+{
+    int rv = 0;
+
+    LOG(LOG_LEVEL_DEBUG, "xrdp_input_unicode_destory: ibus input is under destory");
+    if (last_input_name)
+    {
+        LOG(LOG_LEVEL_INFO, "xrdp_input_unicode_destory: ibus engine rolling back to origin: %s", last_input_name);
+        if (!ibus_bus_set_global_engine(bus, last_input_name))
+        {
+            LOG(LOG_LEVEL_ERROR, "xrdp_input_unicode_destroy: engine restore failed");
+            rv = 1;
+        }
+    }
+
+    g_clear_pointer(&last_input_name, g_free);
+
+    /* A viewer disconnect is not the end of the desktop session. Keep the
+     * bus, factory and single GLib thread for the next viewer connection. */
+    return rv;
+}
+
+int
+xrdp_input_unicode_init(void)
+{
+    IBusEngineDesc *desc;
+    unsigned int attempt;
+
+    if (bus)
+    {
+        /* Already initialized, just re-enable it */
+        return xrdp_input_enable();
+    }
+
+    /* Wait because the ibus daemon may not be ready on first login */
+    const char *addr = ibus_get_address();
+    unsigned int cnt = 0;
+    while (!addr && cnt < 10)
+    {
+        usleep(500 * 1000); // half a second
+        addr = ibus_get_address();
+        ++cnt;
+    }
+    if (!addr)
+    {
+        LOG(LOG_LEVEL_ERROR,
+            "xrdp_ibus_init: Timed out waiting for iBus daemon");
+        return 1;
+    }
+
+    LOG(LOG_LEVEL_INFO, "xrdp_ibus_init: Initializing the iBus engine");
+    ibus_init();
+    bus = ibus_bus_new();
+    g_object_ref_sink(bus);
+
+    if (!ibus_bus_is_connected(bus))
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_ibus_init: Connect to iBus failed");
+        g_clear_object(&bus);
+        return 1;
+    }
+
+    LOG(LOG_LEVEL_INFO, "xrdp_ibus_init: iBus connected");
+
+    desc = ibus_bus_get_global_engine(bus);
+    if (desc == NULL)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_ibus_init: failed to get origin global engine");
+        g_clear_object(&bus);
+        return 1;
+    }
+    g_object_unref(desc);
+    if (tc_thread_create(xrdp_input_main_loop, NULL) != 0)
+    {
+        LOG(LOG_LEVEL_ERROR, "xrdp_ibus_init: could not start input loop");
+        _exit(1);
+    }
+    for (attempt = 0; attempt < 500; ++attempt)
+    {
+        if (g_atomic_int_get(&factory_ready))
+        {
+            return 0;
+        }
+        g_usleep(10000);
+    }
+    LOG(LOG_LEVEL_ERROR, "xrdp_ibus_init: input factory did not become ready");
+    _exit(1);
+
+    return 1;
+}
