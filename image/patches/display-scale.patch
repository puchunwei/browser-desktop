 /*****************************************************************************/
 /* http://msdn.microsoft.com/en-us/library/cc240510.aspx
    2.2.1.3.2 Client Core Data (TS_UD_CS_CORE) */
+/* Optional CS_CORE scale fields form a pair, including when truncated. */
+static void
+xrdp_sec_read_desktop_scale(struct stream *s, struct xrdp_client_info *client_info)
+{
+    unsigned int desktop;
+    unsigned int device;
+    client_info->session_desktop_scale = 0;
+    client_info->session_device_scale = 0;
+    if (!s_check_rem(s, 8))
+    {
+        return;
+    }
+    in_uint32_le(s, desktop);
+    in_uint32_le(s, device);
+    if (desktop >= 100 && desktop <= 500 &&
+            (device == 100 || device == 140 || device == 180))
+    {
+        client_info->session_desktop_scale = desktop;
+        client_info->session_device_scale = device;
+    }
+}
+
 static int
 xrdp_sec_process_mcs_data_CS_CORE(struct xrdp_sec *self, struct stream *s)
 {
@@ -1895,6 +1917,8 @@
     /* Clear physical sizes. These are optional and may not be read later */
     client_info->session_physical_width = 0;
     client_info->session_physical_height = 0;
+    client_info->session_desktop_scale = 0;
+    client_info->session_device_scale = 0;
 
     /* TS_UD_CS_CORE required fields */
     if (!s_check_rem_and_log(s, CS_CORE_MIN_LENGTH,
@@ -2153,8 +2177,22 @@
     LOG_DEVEL(LOG_LEVEL_TRACE, "Received [MS-RDPBCGR] TS_UD_CS_CORE "
               "<Optional Field> desktopOrientation (ignored)");
 
+    xrdp_sec_read_desktop_scale(s, client_info);
     return 0;
 #undef CS_CORE_MIN_LENGTH
+}
+
+/* CS_CORE optional fields end at this GCC block, not the enclosing packet. */
+static int
+xrdp_sec_process_core_block(struct xrdp_sec *self, struct stream *s, int length)
+{
+    struct stream core = *s;
+    if (length < 0 || !s_check_rem(s, length))
+    {
+        return 1;
+    }
+    core.end = core.p + length;
+    return xrdp_sec_process_mcs_data_CS_CORE(self, &core);
 }
 
