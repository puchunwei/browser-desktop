--- a/xup/xup.c
+++ b/xup/xup.c
@@ -26,6 +26,71 @@
 #include "log.h"
 #include "trans.h"
 #include "string_calls.h"
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+/* Called only after authentication, from the connected Xorg module. A missing
+ * or congested controller must never hold up the RDP worker. No client strings
+ * are logged or written to disk; the controller hashes the bounded hint. */
+static void
+send_desktop_scale(struct mod *mod, const char *kind, int width, int height,
+                   int count, const struct monitor_info *monitors)
+{
+    const struct xrdp_client_info *ci = &mod->client_info;
+    static const char hex[] = "0123456789abcdef";
+    char hint[sizeof(ci->hostname) * 2 + 1];
+    char message[2048];
+    size_t i;
+    int used = 0;
+    int added;
+    int fd;
+    struct sockaddr_un address;
+    if (width < 1 || width > 32768 || height < 1 || height > 32768 ||
+            count < 0 || count > CLIENT_MONITOR_DATA_MAXIMUM_MONITORS ||
+            (count && monitors == NULL))
+    {
+        return;
+    }
+    for (i = 0; i < sizeof(ci->hostname) && ci->hostname[i] != '\0'; ++i)
+    {
+        unsigned char c = (unsigned char)ci->hostname[i];
+        hint[i * 2] = hex[c >> 4];
+        hint[i * 2 + 1] = hex[c & 15];
+    }
+    hint[i * 2] = '\0';
+#define SCALE_APPEND(...) do { \
+    added = snprintf(message + used, sizeof(message) - used, __VA_ARGS__); \
+    if (added < 0 || (size_t)added >= sizeof(message) - used) { return; } \
+    used += added; \
+} while (0)
+    SCALE_APPEND("{\"op\":\"event\",\"kind\":\"%s\",\"desktop\":%u,"
+                 "\"device\":%u,\"hint\":\"%s\",\"os\":[%d,%d],"
+                 "\"width\":%d,\"height\":%d,\"monitors\":[",
+                 kind, ci->session_desktop_scale, ci->session_device_scale,
+                 hint, ci->client_os_major, ci->client_os_minor, width, height);
+    for (i = 0; i < (size_t)count; ++i)
+    {
+        SCALE_APPEND("%s[%u,%u]", i ? "," : "",
+                     monitors[i].desktop_scale_factor, monitors[i].device_scale_factor);
+    }
+    SCALE_APPEND("]}");
+#undef SCALE_APPEND
+    fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+    {
+        return;
+    }
+    memset(&address, 0, sizeof(address));
+    address.sun_family = AF_UNIX;
+    snprintf(address.sun_path, sizeof(address.sun_path), "%s",
+             "/run/xrdp/display-scale/control.sock");
+    (void)sendto(fd, message, used, MSG_DONTWAIT | MSG_NOSIGNAL,
+                 (struct sockaddr *)&address, sizeof(address));
+    close(fd);
+}
 
